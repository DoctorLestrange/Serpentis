# Serpentis runs 100% client-side in the browser and requires NO API keys or backend services.
#
# Optional build-time configuration:
# VITE_BASE_PATH controls the public base path emitted by `npm run build`.
# Defaults to "./" for portable static hosting (GitHub Pages, Netlify, Vercel, S3, etc.).
# Example for an explicit subpath: VITE_BASE_PATH="/Serpentis/"
VITE_BASE_PATH="./"
