{
  "name": "serpentis-arcade-snake",
  "private": true,
  "version": "1.0.0",
  "description": "Serpentis — A studio-grade tactile arcade snake game built with React 19, TypeScript, Tailwind CSS v4, and HTML5 Canvas 2D.",
  "license": "Apache-2.0",
  "homepage": "https://doctorlestrange.github.io/Serpentis/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DoctorLestrange/Serpentis.git"
  },
  "bugs": {
    "url": "https://github.com/DoctorLestrange/Serpentis/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "snake",
    "arcade-game",
    "html5-canvas",
    "react",
    "typescript",
    "tailwindcss",
    "web-audio",
    "vite",
    "github-pages"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/game/rules.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
